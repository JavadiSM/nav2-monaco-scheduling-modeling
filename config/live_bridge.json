{
  "schema_version": 3,
  "step_ns": 1000000,
  "placement": "local",
  "policy": "ready_FIFO_shortest_finish_queue_nonpreemptive",
  "arrival_policy": "actual_callback_entry",
  "budget_policy": "actual_CPU_mean_LO_observed_max_HI",
  "thermal_control_epoch_s": 0.001,
  "settle_quiet_host_s": 0.002,
  "host_computation_timeout_s": 30.0,
  "runtime_location": "/tmp with a unique directory-derived identifier",
  "bootstrap_sim_s": 6.0,
  "vehicle_count": 1,
  "vehicle_color": "red",
  "gantt_window_s": 2.0,
  "action_ack_timeout_ms": 1000,
  "output_policy": "buffer_until_sealed_computation_and_selected_budget_completion",
  "task_criticality": "HI",
  "low_criticality_tasks_enabled": false,
  "dvfs": {
    "policy": "fixed",
    "decision_epoch_s": 0.001,
    "switch_latency_s": 0.0,
    "overrun_policy": "device_maximum_until_overruns_complete",
    "level_id": 2
  },
  "edge_enabled": true,
  "coverage_radius_m": 5.0,
  "random_scope": "covered",
  "deadline_file": "config/task_deadlines.json"
}
